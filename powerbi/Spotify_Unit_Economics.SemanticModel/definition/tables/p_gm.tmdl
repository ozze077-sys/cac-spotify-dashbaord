table p_gm

	column gm_change
		dataType: double
		formatString: +0.0%;-0.0%;0.0%
		summarizeBy: none
		sourceColumn: gm_change

	partition p_gm = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "p_gm.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"gm_change", type number}}, "en-US")
				in
				    Typed
