table p_na

	column na_change
		dataType: double
		formatString: +0%;-0%;0%
		summarizeBy: none
		sourceColumn: na_change

	partition p_na = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "p_na.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"na_change", type number}}, "en-US")
				in
				    Typed
