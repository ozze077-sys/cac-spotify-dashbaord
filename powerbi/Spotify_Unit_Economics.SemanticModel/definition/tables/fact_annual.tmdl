table fact_annual

	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column year_label
		dataType: string
		summarizeBy: none
		sourceColumn: year_label

	column mau_m
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: mau_m

	column premium_subs_m
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: premium_subs_m

	column ad_mau_m
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ad_mau_m

	column premium_rev_usd_m
		dataType: double
		formatString: $#,0
		summarizeBy: none
		sourceColumn: premium_rev_usd_m

	column ad_rev_usd_m
		dataType: double
		formatString: $#,0
		summarizeBy: none
		sourceColumn: ad_rev_usd_m

	column total_rev_usd_m
		dataType: double
		formatString: $#,0
		summarizeBy: none
		sourceColumn: total_rev_usd_m

	column gross_profit_usd_m
		dataType: double
		formatString: $#,0
		summarizeBy: none
		sourceColumn: gross_profit_usd_m

	column opex_usd_m
		dataType: double
		formatString: $#,0
		summarizeBy: none
		sourceColumn: opex_usd_m

	column op_income_usd_m
		dataType: double
		formatString: $#,0
		summarizeBy: none
		sourceColumn: op_income_usd_m

	column fcf_usd_m
		dataType: double
		formatString: $#,0
		summarizeBy: none
		sourceColumn: fcf_usd_m

	column sm_usd_m
		dataType: double
		formatString: $#,0
		summarizeBy: none
		sourceColumn: sm_usd_m

	column premium_net_adds_m
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: premium_net_adds_m

	column arpu_monthly_usd
		dataType: double
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: arpu_monthly_usd

	column ad_rev_per_ad_mau_usd
		dataType: double
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: ad_rev_per_ad_mau_usd

	column rev_per_mau_usd
		dataType: double
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: rev_per_mau_usd

	column gross_margin
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: gross_margin

	column op_margin
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: op_margin

	column fcf_margin
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: fcf_margin

	column opex_ratio
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: opex_ratio

	column sm_pct_rev
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: sm_pct_rev

	column rev_growth
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: rev_growth

	column premium_rev_growth
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: premium_rev_growth

	column ad_rev_growth
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: ad_rev_growth

	column premium_sub_growth
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: premium_sub_growth

	column mau_growth
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: mau_growth

	column premium_mix
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: premium_mix

	column paying_share
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: paying_share

	partition fact_annual = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_annual.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"year", Int64.Type}, {"year_label", type text}, {"mau_m", Int64.Type}, {"premium_subs_m", Int64.Type}, {"ad_mau_m", Int64.Type}, {"premium_rev_usd_m", type number}, {"ad_rev_usd_m", type number}, {"total_rev_usd_m", type number}, {"gross_profit_usd_m", type number}, {"opex_usd_m", type number}, {"op_income_usd_m", type number}, {"fcf_usd_m", type number}, {"sm_usd_m", type number}, {"premium_net_adds_m", type number}, {"arpu_monthly_usd", type number}, {"ad_rev_per_ad_mau_usd", type number}, {"rev_per_mau_usd", type number}, {"gross_margin", type number}, {"op_margin", type number}, {"fcf_margin", type number}, {"opex_ratio", type number}, {"sm_pct_rev", type number}, {"rev_growth", type number}, {"premium_rev_growth", type number}, {"ad_rev_growth", type number}, {"premium_sub_growth", type number}, {"mau_growth", type number}, {"premium_mix", type number}, {"paying_share", type number}}, "en-US")
				in
				    Typed
