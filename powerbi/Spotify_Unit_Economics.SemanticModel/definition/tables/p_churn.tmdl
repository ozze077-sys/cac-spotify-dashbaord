table p_churn

	column churn
		dataType: double
		formatString: 0.00%
		summarizeBy: none
		sourceColumn: churn

	partition p_churn = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "p_churn.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"churn", type number}}, "en-US")
				in
				    Typed
